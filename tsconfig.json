{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["@types/bun"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "demos/**/*.ts", "spikes/**/*.ts"]
}
